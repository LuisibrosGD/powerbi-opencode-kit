{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Get-ChildItem *": "allow",
      "Measure-Object *": "allow",
      "Test-Path *": "allow",
      "Select-Object *": "allow",
      "npm run *": "ask",
      "npm test *": "allow",
      "powerbi-report-author *": "allow",
      "npm exec -- powerbi-report-author *": "allow",
      "npm install *": "ask",
      "npm uninstall *": "ask",

      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask"
    },
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "share": "manual",
  "autoupdate": "notify",
  "formatter": false,
  "mcp": {
    "powerbi-modeling": {
      "type": "local",
      "command": ["npx", "-y", "@microsoft/powerbi-modeling-mcp@1.0.0", "--start"],
      "enabled": true
    }
  },
  "compaction": {
    "auto": true
  }
}
