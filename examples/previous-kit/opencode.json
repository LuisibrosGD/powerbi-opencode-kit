{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "npm run *": "ask",
      "npm test *": "allow",
      "powerbi-report-author *": "allow",
      "npm install *": "ask",
      "npm uninstall *": "ask",

      "git commit *": "ask",
      "git push *": "deny"
    },
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "share": "manual",
  "autoupdate": "notify",
  "formatter": false,
  "mcp": {
    "powerbi-modeling": {
      "type": "local",
      "command": ["npx", "-y", "@microsoft/powerbi-modeling-mcp", "--start"],
      "enabled": true
    }
  },
  "compaction": {
    "auto": true
  }
}
